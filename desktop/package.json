{
  "name": "cortex-desktop",
  "productName": "Cortex",
  "version": "1.0.9",
  "description": "Cortex'in masaüstü uygulaması: kasayı Obsidian gibi okur ve yazar.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "SoleLuna Tech (Tolga Gündüz)",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.core.json",
    "test": "node scripts/test.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "cortex-paket": "node scripts/cortex-paket.mjs",
    "python-paket": "node scripts/python-paket.mjs",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3-force": "^3.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "d3-force": "^3.0.0",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.11"
  },
  "build": {
    "appId": "com.soleluna.cortex",
    "productName": "Cortex",
    "copyright": "Copyright © SoleLuna Tech",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "../tema/ananas/marka/pyn-muhur-200.png",
        "to": "pyn-muhur-200.png"
      },
      {
        "from": "../tema/ananas/marka/pyn.ico",
        "to": "pyn.ico"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "cortex-paket",
        "to": "cortex",
        "filter": [
          "beyin-v3-*.zip"
        ]
      },
      {
        "from": "python-paket",
        "to": "python",
        "filter": [
          "python-*.exe"
        ]
      },
      {
        "from": "../MARKA.md",
        "to": "MARKA.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../tema/ananas/marka/pyn.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cortex",
      "installerIcon": "../tema/ananas/marka/pyn.ico",
      "uninstallerIcon": "../tema/ananas/marka/pyn.ico",
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "language": "1055"
    }
  }
}
